# Copy this file to .env and fill in real values. Never commit .env itself.

# HTTP port the Express server listens on.
PORT=4000

# Path to the SQLite database file. Defaults to ./ticketing.db next to db.js
# if unset.
# DB_PATH=./ticketing.db

# SMTP credentials for outgoing ticket notification emails (Nodemailer).
# If SMTP_HOST / SMTP_USER / SMTP_PASS are left unset, email notifications
# are automatically disabled and every ticket action still works normally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
