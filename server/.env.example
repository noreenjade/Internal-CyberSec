# Copy this file to .env and fill in real values. Never commit .env itself.

# HTTP port the Express server listens on.
PORT=4000

# Path to the SQLite database file. Defaults to ./ticketing.db next to db.js
# if unset.
# DB_PATH=./ticketing.db

# SMTP credentials for outgoing ticket notification emails (Nodemailer).
# If SMTP_HOST / SMTP_USER / SMTP_PASS are left unset, email notifications
# are automatically disabled and every ticket action still works normally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sign-In (see server/auth.js). Leave all three blank/unset and the
# app runs exactly as it does today — no login screen, currentUserId stays
# hardcoded to "u1". Fill in all three to turn real sign-in on:
#   1. GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — from a Google Cloud
#      Console OAuth 2.0 Client ID (APIs & Services -> Credentials ->
#      Create Credentials -> OAuth client ID -> Web application). Add
#      GOOGLE_REDIRECT_URI below as an "Authorized redirect URI" there too.
#   2. JWT_SECRET — any long random string, used only to sign this app's
#      own session cookie (never sent to Google). Generate one with:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=

# Must exactly match an "Authorized redirect URI" on the OAuth client
# above. Update this to the real Cloud Run/domain URL + "/auth/google/callback"
# once deployed — localhost only works for testing on your own machine.
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Only Google accounts ending in this domain can sign in (checked against
# the verified email in the Google ID token, not just the account chooser
# hint). Leave blank to allow any Google account — not recommended once
# deployed publicly.
ALLOWED_EMAIL_DOMAIN=maroonstudios.com
